# Entur — ücretsiz, API anahtarı YOK. Sadece kendini tanıtman gerekiyor.
# Tanıtmayanlara sıkı hız sınırı uygulanıyor, bu yüzden gerçek bir ad yaz.
ENTUR_CLIENT_NAME=cobban-app

# MET Norway — ücretsiz. User-Agent zorunlu ve iletişim bilgisi içermeli.
MET_USER_AGENT=cobban/0.1 hei@cobban.com

# Canlı veri kapalıyken uygulama sabit demo verisiyle çalışır.
# Üretimde "true" yap.
COBBAN_LIVE_DATA=false
