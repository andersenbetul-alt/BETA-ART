# ---------------------------------------------------------------------------
# NAVIAR pilot API — copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------
PORT=8787

# Origin(s) allowed to call this API, comma separated.
ALLOWED_ORIGINS=http://localhost:8099,https://naviar.no

# Where booking notifications are sent. Notifications never contain case text.
NOTIFY_EMAIL=post@naviar.no

# --- Stripe (card payments) ------------------------------------------------
# Live keys belong in the host's secret store, not in a file on disk.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Where Stripe returns the customer after checkout.
PUBLIC_SITE_URL=http://localhost:8099

# --- Vipps ePayment (Norway) ----------------------------------------------
# Left unimplemented on purpose: enable only after the merchant agreement and
# the payment-provider review in Blueprint 12.4 are complete.
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=

# --- Admin ----------------------------------------------------------------
# Bearer token for /api/insights. Generate with: openssl rand -hex 32
ADMIN_TOKEN=
