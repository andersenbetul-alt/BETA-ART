# --- Site adresi ---------------------------------------------------------
# Canonical adresler, sitemap ve Open Graph bağlantıları bu değerden üretilir.
# Canlı ortamda kendi alan adınızı yazın.
NEXT_PUBLIC_SITE_URL=https://naviar.com

# --- İletişim formu e-posta gönderimi ------------------------------------
# Üçü birden tanımlıysa görüşme talepleri e-posta ile iletilir.
# Tanımlı değilse talep yalnızca sunucu günlüğüne yazılır (site yine çalışır).
#
# RESEND_API_KEY : https://resend.com adresinden alınan API anahtarı
# CONTACT_INBOX  : taleplerin düşeceği adres
# CONTACT_FROM   : gönderen adres (Resend'de doğrulanmış alan adı olmalı)
RESEND_API_KEY=
CONTACT_INBOX=info@naviar.com
CONTACT_FROM=NAVIAR <bildirim@naviar.com>

# --- Ölçüm ----------------------------------------------------------------
# Boş bırakılırsa tarayıcıdan hiçbir olay gönderilmez; site bugünkü gibi
# tamamen ölçümsüz çalışır. Ölçüm çerezsiz ve kalıcı kimliksiz tasarlandığı
# için onay bandına gerek yoktur — bu sözü bozacak bir sağlayıcı seçilirse
# gizlilik metni de güncellenmelidir.
#
# Desteklenen değer: plausible
NEXT_PUBLIC_ANALYTICS=
