# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Service role key. Server-side ONLY — it bypasses Row Level Security.
# Never ship this to a browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for the SAME Supabase project.
# Use the connection pooler URI for serverless deployments.
DATABASE_URL=

PORT=3000
