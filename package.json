{
  "name": "beta-art",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test 'dist-test/test/**/*.test.js'"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.2"
  }
}
