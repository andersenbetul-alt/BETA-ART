# Supabase project settings -> API
# Safe to expose: the anon key is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Used to build email confirmation / OAuth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NEVER put the service_role key in this app. It bypasses RLS and any
# NEXT_PUBLIC_ variable is shipped to the browser.
