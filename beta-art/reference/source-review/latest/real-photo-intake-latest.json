  "launch_mix": {
    "Architecture": 5,
    "Hospitality": 4,
    "Energy & Renewables": 4,
    "Healthcare & Research": 3,
    "People / Workplace": 4,
    "Nordic Landscape / Context": 4
  },
  "rule": "No asset may display Verified Human Photograph until the real file and required verification checks are present."
}